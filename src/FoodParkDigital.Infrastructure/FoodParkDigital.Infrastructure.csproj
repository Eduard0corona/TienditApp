<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FoodParkDigital.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!-- SixLabors.ImageSharp 3.2.0 checks a Six Labors licence key before compiling this project, the only one that
       references it directly: a Release build fails without it, a Debug build only warns. The key is the whole licence
       issued by Six Labors, in the SIXLABORS_LICENSE_KEY environment variable (a secret in CI, the deployment and the
       Docker build; never in the repository). A SixLaborsLicenseKey or SixLaborsLicenseFile given to the build wins. -->
  <PropertyGroup Condition="'$(SixLaborsLicenseKey)' == '' and '$(SixLaborsLicenseFile)' == '' and '$(SIXLABORS_LICENSE_KEY)' != ''">
    <SixLaborsLicenseKey>$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="GoogleAuthenticator" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- Security pin of a transitive package of Microsoft.Data.SqlClient, not used by this code: see Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoodParkDigital.Application\FoodParkDigital.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FoodParkDigital.Infrastructure.Tests" />
  </ItemGroup>

</Project>
